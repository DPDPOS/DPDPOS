# ---------------------------------------------------------------------------
# DPDPOS frontend — environment variables
# Copy to .env.local and adjust.
# ---------------------------------------------------------------------------

# Backend origin used by the Next.js /api rewrite (next.config.ts).
# Local: http://localhost:3000
# Production (Vercel): https://<your-render-api>.onrender.com
# See dpdpos_backend/docs/14_deployment.md for the full free-tier stack.
BACKEND_URL=http://localhost:3000

# Optional: bypass the rewrite and point the API client at an absolute base.
# Leave empty to keep using the /api rewrite above (recommended for Vercel).
NEXT_PUBLIC_API_BASE_URL=
